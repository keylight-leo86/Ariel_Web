---
import { DEPARTMENTS } from '../data/club';
---
<ol class="dept-list">
  {DEPARTMENTS.map((d, i) => (
    <li class="dept-item" id={d.id}>
      <span class="dept-item__no">{String(i + 1).padStart(2, '0')}</span>
      <span class={`dept-item__name pill pill--${d.tone}`}>{d.name}</span>
      <p class="dept-item__desc">{d.lines[0]}<br />{d.lines[1]}</p>
    </li>
  ))}
</ol>
