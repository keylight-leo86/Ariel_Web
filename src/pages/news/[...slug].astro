---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url, formatDate } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="prose">
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.tags.length > 0 && <ul class="tags">{post.data.tags.map((t) => <li>{t}</li>)}</ul>}
    </header>
    {post.data.cover && <img src={url(post.data.cover)} alt={post.data.coverAlt ?? ''} />}
    <Content />
  </article>
  <p><a href={url('/news')}>← 返回社团动态</a> · <a href={url('/join')}>加入我们 →</a></p>
</BaseLayout>
