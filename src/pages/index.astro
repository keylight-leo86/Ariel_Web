---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import DepartmentList from '../components/DepartmentList.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import JoinCard from '../components/JoinCard.astro';
import { SITE } from '../site.config';
import { INTRO, DEPARTMENTS_HEADING, ACTIVITIES_HEADING, ACTIVITY_TAGS, ACTIVITY_POINTS, ACTIVITY_NOTE } from '../data/club';
import { url } from '../utils/url';
---
<BaseLayout>
  <section class="hero">
    <p class="hero__school">{SITE.school}</p>
    <p class="hero__en">{SITE.titleEn}</p>
    <h1 class="hero__title">{SITE.title}</h1>
    <p class="hero__badge">欢迎新同学！</p>
    <p class="hero__tagline">{SITE.tagline}</p>
    <p class="hero__slogan">{SITE.slogan}</p>
    <a class="btn btn--primary" href={url('/join')}>加入我们</a>
  </section>

  <section class="intro-block">
    {INTRO.map((line) => <p>{line}</p>)}
  </section>

  <section>
    <SectionTitle no="01" title={DEPARTMENTS_HEADING.title} sub={DEPARTMENTS_HEADING.sub} en={DEPARTMENTS_HEADING.en} />
    <DepartmentList />
    <p><a href={url('/departments')}>了解部门 →</a></p>
  </section>

  <section>
    <SectionTitle no="02" title={ACTIVITIES_HEADING.title} en={ACTIVITIES_HEADING.en} />
    <p class="activity-tags">{ACTIVITY_TAGS.join(' · ')}</p>
    <ul class="activity-points">{ACTIVITY_POINTS.map((p) => <li>{p}</li>)}</ul>
    <PhotoGrid />
    <p class="note">{ACTIVITY_NOTE}</p>
  </section>

  <JoinCard />
</BaseLayout>
